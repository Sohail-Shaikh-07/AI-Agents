# ------------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------------

# 1. Google Sheets Configuration
# Retrieve the Sheet ID from the URL: docs.google.com/spreadsheets/d/[ID]/edit
GOOGLE_SHEET_ID=

# 2. Google Service Account (Base64 Encoded JSON)
# Run `base64 -w 0 credentials.json` to generate this string
GOOGLE_JSON=
